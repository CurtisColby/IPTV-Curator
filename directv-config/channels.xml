<?xml version="1.0" encoding="UTF-8"?>
<!-- ═══════════════════════════════════════════════════════════════════
     Custom channel list for the iptv-org/epg scraper (DirecTV guide)
     Mounted into the Docker container at /epg/public/channels.xml

     The xmltv_id you set here becomes the channel ID in guide.xml.
     These IDs are what you'll pick in the IPTV Curator matching modal
     and what NostalgiaTV binds to.

     To add a channel: find its site_id in
     https://raw.githubusercontent.com/iptv-org/epg/master/sites/directv.com/directv.com.channels.xml
     copy the line here, and give it an xmltv_id.

     To remove a channel: just delete the line. Fewer channels = faster scrape.
     ═══════════════════════════════════════════════════════════════════ -->
<channels>
  <!-- Showtime family -->
  <channel site="directv.com" site_id="23e1c6f4-81ce-4cbd-948b-93619740b339" lang="en" xmltv_id="Showtime2.us">SHOWTIME 2 HD</channel>
